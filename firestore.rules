rules_version = '2';

// WSL Realty Firestore rules.
// Visitors: read published site content, and CREATE (never read) enquiries.
// Staff (a document at staff/<uid>): manage content, projects and enquiries.
// Admins (role "admin"): also manage the team and delete enquiries.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.role in ['admin', 'editor'];
    }
    function isAdmin() { return isStaff() && staffDoc().data.role == 'admin'; }

    // Team. Read your own record (the app uses it to learn your role); admins read all.
    // Admins can add, change and remove other people, never themselves.
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'created_at'])
        && request.resource.data.role in ['admin', 'editor']
        && request.resource.data.email is string && request.resource.data.email.size() <= 255;
      allow update: if isAdmin() && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['admin', 'editor'];
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Editable page text (hero, about, contact, values, ...).
    // Lists have a maximum size: properties 25, furniture 30, previous jobs 30.
    function listWithin(n) { return request.resource.data.value is list && request.resource.data.value.size() <= n; }
    match /content/{section} {
      allow read: if true;
      allow write: if isStaff() && !(section in ['properties', 'furniture', 'jobs']);
    }
    match /content/properties { allow read: if true; allow write: if isStaff() && listWithin(25); }
    match /content/furniture { allow read: if true; allow write: if isStaff() && listWithin(30); }
    match /content/jobs { allow read: if true; allow write: if isStaff() && listWithin(30); }

    // Projects such as Arya Luxe, with their build stages stored on the document.
    // The Arya Luxe photo gallery holds at most 20 photos.
    match /projects/{slug} {
      allow read: if true;
      allow write: if isStaff()
        && (!('gallery' in request.resource.data) || (request.resource.data.gallery is list && request.resource.data.gallery.size() <= 20));
    }

    // Progress updates. The public site must query with published == true; drafts are staff-only.
    match /projectUpdates/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow write: if isStaff();
    }

    // Enquiries: anyone may create a well-formed one. A signed-in customer's enquiry carries their uid, so they
    // can read their own enquiry and its conversation. Staff read and manage all of them.
    match /enquiries/{id} {
      function isOwner() { return signedIn() && resource.data.user_id == request.auth.uid; }

      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'interest', 'message', 'source', 'status', 'notes', 'handled_by', 'created_at', 'user_id'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'email', 'interest', 'message', 'source', 'status', 'notes', 'handled_by', 'created_at'])
        && (request.resource.data.get('user_id', null) == null || (signedIn() && request.resource.data.user_id == request.auth.uid))
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 5 && request.resource.data.phone.size() <= 30
        && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 255))
        && (request.resource.data.interest == null || (request.resource.data.interest is string && request.resource.data.interest.size() <= 200))
        && (request.resource.data.message == null || (request.resource.data.message is string && request.resource.data.message.size() <= 1000))
        && request.resource.data.source is string && request.resource.data.source.size() <= 120
        && request.resource.data.status == 'new'
        && request.resource.data.notes == null
        && request.resource.data.handled_by == null
        && request.resource.data.created_at == request.time;
      allow read: if isStaff() || isOwner();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'handled_by', 'seen_at', 'seen_by'])
        && request.resource.data.status in ['new', 'contacted', 'closed']
        && (request.resource.data.notes == null || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
        // Who handled or saw an enquiry, and when, cannot be faked: it must be the signed-in team member and the server clock.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['handled_by']) || request.resource.data.handled_by == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['seen_by']) || request.resource.data.seen_by == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['seen_at']) || request.resource.data.seen_at == request.time);
      allow delete: if isAdmin();

      // The conversation: replies from the team and follow-ups from the customer.
      match /messages/{mid} {
        function ownsEnquiry() { return signedIn() && get(/databases/$(database)/documents/enquiries/$(id)).data.get('user_id', null) == request.auth.uid; }

        allow read: if isStaff() || ownsEnquiry();
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'author', 'created_at', 'seen_at'])
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.author is string && request.resource.data.author.size() <= 120
          && request.resource.data.seen_at == null
          && request.resource.data.created_at == request.time
          && ((request.resource.data.from == 'staff' && isStaff()) || (request.resource.data.from == 'customer' && ownsEnquiry()));
        // The other side marks a message as seen; nothing else may change.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen_at'])
          && request.resource.data.seen_at == request.time
          && ((resource.data.from == 'customer' && isStaff()) || (resource.data.from == 'staff' && ownsEnquiry()));
        allow delete: if isAdmin();
      }
    }

    // Media library: the photos staff have uploaded (Cloudinary links only), so they can be reused.
    match /media/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['url', 'name', 'created_at'])
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && request.resource.data.url.matches('^https://res\\.cloudinary\\.com/.*')
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.created_at == request.time;
      allow update: if false;
      allow delete: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
